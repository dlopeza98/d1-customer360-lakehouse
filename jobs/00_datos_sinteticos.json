{
  "name": "[C360] 00 · Generar datos sintéticos",
  "description": "Reproduce las 2 fuentes en alcance de D1 con sus patologías reales. Semilla fija: dos corridas producen lo mismo, requisito para validar paridad entre nubes.",
  "tags": { "proyecto": "1531-d1-customer360", "capa": "bronze" },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "generar",
      "notebook_task": {
        "notebook_path": "../notebooks/00_generar_datos_sinteticos.py",
        "base_parameters": {
          "catalogo": "${var.catalogo}",
          "n_personas": "${var.n_personas}",
          "semilla": "1531"
        }
      },
      "job_cluster_key": "estandar",
      "timeout_seconds": 3600
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "estandar",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "num_workers": 2,
        "data_security_mode": "SINGLE_USER"
      }
    }
  ]
}
