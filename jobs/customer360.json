{
  "name": "[C360] Customer 360 · Golden Record",
  "description": "Pipeline completo: genera las fuentes de origen y consolida el Golden Record. Es el job que se redespliega en GCP durante la Fase 8 y cuyo resultado se compara contra el de Azure.",
  "tags": {
    "proyecto": "1531-d1-customer360"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "generar_datos",
      "notebook_task": {
        "notebook_path": "../notebooks/01_generar_datos.py",
        "base_parameters": {
          "catalogo": "${var.catalogo}",
          "n_personas": "${var.n_personas}"
        }
      },
      "job_cluster_key": "c360",
      "timeout_seconds": 3600
    },
    {
      "task_key": "golden_record",
      "depends_on": [
        { "task_key": "generar_datos" }
      ],
      "notebook_task": {
        "notebook_path": "../notebooks/02_golden_record.py",
        "base_parameters": {
          "catalogo": "${var.catalogo}",
          "ruta_reglas": "${workspace.file_path}/jobs/reglas_identidad.json"
        }
      },
      "job_cluster_key": "c360",
      "timeout_seconds": 7200,
      "max_retries": 1
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "c360",
      "new_cluster": {
        "spark_version": "15.4.x-scala2.12",
        "num_workers": "${var.nodos}",
        "data_security_mode": "SINGLE_USER"
      }
    }
  ]
}
